  "statement": "A loading dock lists the weights of crates waiting to ship, in the order they arrived. A truck has exactly `capacity` kilograms of space left.\n\nReturn the positions of two different crates whose weights add up to exactly `capacity`, smaller position first. Exactly one such pair exists.",
  "examples": [
    {
      "input": "weights = [4, 9, 2, 7], capacity = 11",
      "output": "[1, 2]",
      "explanation": "9 + 2 = 11."
    },
    {
      "input": "weights = [5, 5], capacity = 10",
      "output": "[0, 1]"
    }
  ],
  "signature": {
    "name": "crate_pair",
    "params": [
      {
        "name": "weights",
        "type": "int[]"
      },
      {
        "name": "capacity",
        "type": "int"
      }
    ],
    "returns": "int[]"
  },
  "starterCode": {
    "python": "def crate_pair(weights, capacity):\n    pass\n",
    "javascript": "function crate_pair(weights, capacity) {\n\n}\n"
  },
