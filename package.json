{
  "name": "think-aloud",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source trainer for thinking out loud in coding interviews. Static web app, bring your own AI key.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-runtime-assets.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "problems:validate": "tsx scripts/validate-problems.ts",
    "problems:check-solutions": "tsx scripts/check-reference-solutions.ts",
    "problems:analyze": "tsx scripts/generate-analysis.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "idb": "8.0.4",
    "monaco-editor": "0.57.0",
    "pyodide": "0.29.5",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "minimatch": "11.0.7"
  }
}
